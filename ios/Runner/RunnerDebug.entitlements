<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug entitlements: a development-signed build must use the SANDBOX APNs
	     environment. Kept separate from Runner.entitlements so a debug build on a
	     Mac never accidentally requests production APNs (and vice versa). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
