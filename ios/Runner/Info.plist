<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>WIIN</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>wiinz_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Purpose strings. ENGLISH here in the base Info.plist; Arabic and French
	     live in ar.lproj/fr.lproj/InfoPlist.strings and override these on a
	     device set to those languages.
	     ⚠️ DO NOT put Arabic first in this file again. Build 7 shipped
	     Arabic-first strings with English trailing after an em-dash, and was
	     REJECTED under Guideline 2.5.1 + 5.1.1 ("purpose strings … do not
	     clearly state why access is needed") — an English-locale reviewer saw a
	     wall of Arabic before reaching the reason. The base string is what any
	     locale without its own .lproj falls back to, including Apple's.
	     Each string must say WHAT is accessed, WHY, and WHAT HAPPENS TO THE
	     DATA — the third part is what Guideline 5.1.1 asks for. -->
	<key>NSCameraUsageDescription</key>
	<string>WIIN uses the camera only to scan the QR code displayed at a WIIN collection point, so the bottles you deposit there are credited to your account as Wz points. The camera is not used anywhere else, and no photo or video is ever recorded, stored or sent.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>WIIN uses your location only while the app is open, to show the collection points nearest to you on the map and sort them by distance. Your location stays on your device: it is never uploaded, stored or shared.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>WIIN opens your photo library only when you tap your profile picture to change it. Only the single image you choose is uploaded, and it is used solely as your avatar inside the app.</string>
	<!-- ⚠️ NSLocationAlwaysAndWhenInUseUsageDescription is DELIBERATELY ABSENT.
	     Commit 0419291 added it to silence the ITMS-90683 delivery WARNING.
	     Do not ship it. ITMS-90683 is a warning on a delivery Apple accepts —
	     build 7 went straight into review carrying it. Declaring an
	     always/background location purpose string in an app that has no
	     background-location feature is the textbook trigger for the very
	     Guideline 2.5.1/5.1.1 rejection this app just received, and it would
	     also contradict the App Privacy answer (Location NOT collected) and the
	     privacy policy at wiinalgeria.com/confidentialite. -->

	<!-- The app ships no encryption of its own; it only talks HTTPS to the WIIN
	     API, which is exempt. Declaring it here means TestFlight never blocks a
	     build on the export-compliance question. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- FCM: lets a push wake the app to handle a data payload. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- The App Store listing advertises these three languages. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
		<string>fr</string>
		<string>en</string>
	</array>
</dict>
</plist>
