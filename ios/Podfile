# WIIN — iOS CocoaPods configuration
#
# This file is normally generated by `flutter build ios` on a Mac. It is
# hand-written and COMMITTED here because the project is developed on Windows,
# where Flutter refuses to generate it, and Codemagic's build runs
# `pod install` before anything else could create one.
#
# It is the stock Flutter template plus one addition: the permission_handler
# preprocessor macros in `post_install` (see the note down there — without them
# the App Store upload is rejected).

platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously, slowing down the build.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run `flutter build ios --config-only` before `pod install`."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run `flutter pub get`"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Some transitive pods still declare an older minimum than the app does,
      # which Xcode 15+ warns (and sometimes errors) on.
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 13.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      end

      # permission_handler compiles EVERY permission handler into the binary by
      # default — contacts, calendar, microphone, health, and so on. Apple's
      # automated check then rejects the upload (ITMS-90683) because the binary
      # references privacy-sensitive APIs that have no matching usage string in
      # Info.plist. WIIN only ever asks for camera, location and notifications,
      # so every other handler is compiled OUT here.
      #
      # If the app ever starts asking for a new permission: flip its macro to 1
      # AND add the matching NS*UsageDescription to Info.plist. Doing only one of
      # the two either crashes on request or fails the upload.
      # CocoaPods hands this back as either an Array or a bare String depending on
      # the pod, so normalise before appending or `+` blows up mid-install.
      existing = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      existing = [existing] if existing.is_a?(String)
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = existing + [
        'PERMISSION_EVENTS=0',
        'PERMISSION_EVENTS_FULL_ACCESS=0',
        'PERMISSION_REMINDERS=0',
        'PERMISSION_CONTACTS=0',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=0',
        'PERMISSION_SPEECH_RECOGNIZER=0',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_MEDIA_LIBRARY=0',
        'PERMISSION_SENSORS=0',
        'PERMISSION_BLUETOOTH=0',
        'PERMISSION_APP_TRACKING_TRANSPARENCY=0',
        'PERMISSION_CRITICAL_ALERTS=0',
        'PERMISSION_ASSISTANT=0',
      ]
    end
  end
end
